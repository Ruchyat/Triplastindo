# Backend Laravel yang dituju proxy dev server.
# Disajikan oleh Laravel Valet, bukan "php artisan serve".
# Frontend memanggil "/api" pada origin yang sama, lalu Vite meneruskannya ke sini.
VITE_API_PROXY_TARGET=http://be-triplastindo.test

# Host yang boleh membuka dev server selain localhost, dipisahkan koma.
# Awalan titik mencakup seluruh subdomain.
VITE_ALLOWED_HOSTS=.tplastindo.com,.rmw78.cfd

# Isi hanya bila backend berada di domain terpisah (mis. saat produksi):
# VITE_API_BASE_URL=https://api.triplastindo.com/api
